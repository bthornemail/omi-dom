        "Q10"
      ]
    },
    {
      "step": "s15",
      "text": "NAND2 wire-AND: E(Q10) → C(Q9); NAND2 = C(Q10)",
      "place": [
        "Q10",
        "Q9"
      ]
    },
    {
      "step": "s16",
      "text": "B → Q11; NAND1 → B(Q12); NAND3 = C(Q12)",
      "place": [
        "Q12",
        "Q11"
      ]
    },
    {
      "step": "s17",
      "text": "NAND2 → B(Q13)",
      "place": [
        "Q10",
        "Q13"
      ]
    },
    {
      "step": "s18",
      "text": "NAND3 → B(Q14)",
      "place": [
        "Q12",
        "Q14"
      ]
    },
    {
      "step": "s19",
      "text": "NAND4 wire-AND: E(Q14) → C(Q13); NAND4 = C(Q14)",
